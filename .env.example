# ── Census Bureau API Key ──────────────────────────────────────────────────────
# Sign up free (no credit card) at: https://api.census.gov/data/key_signup.html
# Takes ~2 minutes. Unlocks higher rate limits on all Census API calls.
VITE_CENSUS_API_KEY=YOUR_CENSUS_API_KEY_HERE

# ── OpenAI API Key ────────────────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
# Powers the AI trash-talk and professional report summaries (gpt-4o-mini).
# This key is SERVER-SIDE ONLY — it is never bundled into the browser.
# The /api/summary serverless function reads it from the environment.
# For local development, use `vercel dev` instead of `npm run dev` so the
# /api/summary function runs. Alternatively add a Vite proxy in vite.config.js.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# ── Socrata App Token (optional but recommended) ──────────────────────────────
# Prevents rate limiting on Texas Open Data Portal (data.texas.gov) calls.
# Register free (no credit card) at: https://data.texas.gov/profile/app_tokens
# Takes ~1 minute. Without this token, heavy use (e.g. ranking all 254 counties)
# will hit Socrata's unauthenticated request limit and return empty data.
# Web app: add as VITE_SOCRATA_APP_TOKEN
# MCP server: add as SOCRATA_APP_TOKEN (no VITE_ prefix)
VITE_SOCRATA_APP_TOKEN=YOUR_SOCRATA_APP_TOKEN_HERE
SOCRATA_APP_TOKEN=YOUR_SOCRATA_APP_TOKEN_HERE
